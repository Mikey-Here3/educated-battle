generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  phone        String?       @unique
  ign          String
  uid          String
  avatarUrl    String?
  balancePKR   Float         @default(0.0)
  winningsPKR  Float         @default(0.0)
  bonusPKR     Float         @default(0.0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  slots        Slot[]
  transactions Transaction[]

  @@map("users")
}

model Tournament {
  id              String    @id @default(cuid())
  title           String
  slug            String?   @unique
  description     String?
  game            String    @default("Free Fire MAX")
  type            String
  category        String?   @default("Clash Squad")
  format          String?   @default("1v1")
  mode            String?   @default("Classic")
  platform        String?   @default("Mobile Only")
  map             String
  allowedWeapons  String?
  rules           String?
  status          String    @default("upcoming")
  prizePool       Float
  winnerPrize     Float?    @default(0)
  perKill         Float     @default(0)
  entryFee        Float     @default(0)
  totalSlots      Int       @default(48)
  slotsFilled     Int?      @default(0)
  startTime       DateTime
  matchDate       String?
  matchTime       String?
  isFeatured      Boolean   @default(false)
  roomId          String?
  roomPassword    String?
  bannerUrl       String?
  thumbnailUrl    String?
  mobileBannerUrl String?
  youtubeUrl      String?
  whatsappUrl     String?
  prizesJson      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime? @updatedAt
  slots           Slot[]

  @@map("tournaments")
}

model Slot {
  id           String     @id @default(cuid())
  tournamentId String
  userId       String
  slotNumber   Int
  ign          String
  uid          String
  createdAt    DateTime   @default(now())
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@unique([tournamentId, slotNumber])
  @@map("slots")
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  type      String
  amountPKR Float
  status    String   @default("PENDING")
  method    String?
  trxId     String?
  proofUrl  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@map("transactions")
}
