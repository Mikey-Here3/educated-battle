generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  phone        String?       @unique
  ign          String
  uid          String
  passwordHash String?
  avatarUrl    String?
  role         String        @default("player")
  balancePKR   Float         @default(0.0)
  reservedPKR  Float         @default(0.0)
  winningsPKR  Float         @default(0.0)
  bonusPKR     Float         @default(0.0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  slots        Slot[]
  transactions Transaction[]
  
  teamsLed         Team[]       @relation("TeamLeader")
  teamMemberships  TeamMember[]

  @@map("users")
}

model Tournament {
  id              String    @id @default(cuid())
  title           String
  slug            String?   @unique
  description     String?
  game            String    @default("Free Fire MAX")
  type            String
  category        String?   @default("Clash Squad")
  format          String?   @default("1v1")
  mode            String?   @default("Classic")
  platform        String?   @default("Mobile Only")
  map             String
  allowedWeapons  String?
  rules           String?
  status          String    @default("upcoming")
  prizePool       Float
  winnerPrize     Float?    @default(0)
  perKill         Float     @default(0)
  entryFee        Float     @default(0)
  
  // New architecture fields
  entryFeeModel   String    @default("PLAYER_ENTRY") // PLAYER_ENTRY, TEAM_ENTRY
  matchType       String    @default("SINGLE_MATCH") // SINGLE_MATCH, MULTI_MATCH
  totalSlots      Int       @default(48) // Total max players
  slotsFilled     Int?      @default(0)
  maxTeams        Int?      // Null means unbounded or derived from totalSlots/teamSize
  teamSize        Int       @default(1)

  startTime       DateTime
  matchDate       String?
  matchTime       String?
  isFeatured      Boolean   @default(false)
  roomId          String?
  roomPassword    String?
  bannerUrl       String?
  thumbnailUrl    String?
  mobileBannerUrl String?
  youtubeUrl      String?
  whatsappUrl     String?
  prizesJson      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime? @updatedAt
  
  slots           Slot[]
  teams           Team[]
  matches         TournamentMatch[]

  @@map("tournaments")
}

model Slot {
  id           String     @id @default(cuid())
  tournamentId String
  userId       String
  teamId       String?
  slotNumber   Int
  ign          String
  uid          String
  createdAt    DateTime   @default(now())
  
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  team         Team?      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, slotNumber])
  @@unique([tournamentId, userId])
  @@map("slots")
}

model Team {
  id                   String     @id @default(cuid())
  tournamentId         String
  teamName             String
  leaderId             String
  paymentTransactionId String?
  status               String     @default("REGISTERED")
  createdAt            DateTime   @default(now())

  tournament           Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  leader               User       @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: Cascade)
  members              TeamMember[]
  slots                Slot[]

  @@unique([tournamentId, teamName])
  @@unique([tournamentId, leaderId])
  @@map("teams")
}

model TeamMember {
  id       String @id @default(cuid())
  teamId   String
  userId   String
  role     String @default("MEMBER")

  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

model TournamentMatch {
  id           String   @id @default(cuid())
  tournamentId String
  matchNumber  Int
  status       String   @default("PENDING") // PENDING, READY, LIVE, COMPLETED, CANCELLED
  roomId       String?
  roomPassword String?
  winnerId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  participants MatchParticipant[]

  @@unique([tournamentId, matchNumber])
  @@map("tournament_matches")
}

model MatchParticipant {
  id       String  @id @default(cuid())
  matchId  String
  userId   String?
  teamId   String?
  score    Int     @default(0)
  placement Int?

  match    TournamentMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@map("match_participants")
}

model Transaction {
  id            String   @id @default(cuid())
  userId        String
  type          String   // DEPOSIT, WITHDRAWAL, MATCH_FEE, PRIZE_WINNING, REFUND
  amountPKR     Float
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  method        String?  // JazzCash, EasyPaisa, Wallet
  trxId         String?
  proofUrl      String?
  accountTitle  String?
  accountNumber String?
  note          String?
  tournamentId  String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transactions")
}
